# Deployment-owned bootstrap values only.
BASE_URL=http://localhost:3000
DATABASE_URL=postgres://ai_gateway:ai_gateway@localhost:5432/ai_gateway
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Exactly 32 random bytes, base64 encoded with a v1: prefix. Back this up with PostgreSQL.
SETTINGS_ENCRYPTION_KEY=v1:replace-with-base64-of-32-random-bytes
# Optional, behind proxies: where each request's client address is, for sign-in rate limits.
# A header your proxy sets to the client's address alone, or the proxies that append to X-Forwarded-For.
# CLIENT_IP_HEADERS=cf-connecting-ip
# TRUSTED_PROXIES=172.16.0.0/12
