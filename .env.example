# Application
BASE_URL=http://localhost:3000
DATABASE_URL=postgres://llm_proxy:llm_proxy@localhost:5432/llm_proxy
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Generic OpenID Connect login
OIDC_ISSUER=https://id.example.com
OIDC_CLIENT_ID=llm-proxy
OIDC_CLIENT_SECRET=replace-me
OIDC_PROVIDER_ID=oidc
OIDC_PROVIDER_LABEL=Company SSO
OIDC_SCOPES=openid,profile,email
OIDC_PKCE=true
OIDC_STRICT_ISSUER_VALIDATION=false
# Prefer immutable OIDC subject values. Verified email is a convenience fallback.
BOOTSTRAP_ADMIN_SUBJECTS=
BOOTSTRAP_ADMIN_EMAILS=admin@example.com

# AWS Bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
# AWS_SESSION_TOKEN=

# Runtime white-label branding
BRAND_NAME=LLM Proxy
BRAND_TAGLINE=Secure, metered access to AI models
BRAND_LOGO_URL=
BRAND_FAVICON_URL=
BRAND_PRIMARY_COLOR=#2563eb
BRAND_PRIMARY_FOREGROUND_COLOR=#ffffff
