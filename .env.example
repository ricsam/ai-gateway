# Deployment-owned bootstrap values only.
BASE_URL=http://localhost:3000
DATABASE_URL=postgres://llm_proxy:llm_proxy@localhost:5432/llm_proxy
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Exactly 32 random bytes, base64 encoded with a v1: prefix. Back this up with PostgreSQL.
SETTINGS_ENCRYPTION_KEY=v1:replace-with-base64-of-32-random-bytes
