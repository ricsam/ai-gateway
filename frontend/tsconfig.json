{
  "compilerOptions": {
    "composite": true,
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "paths": {
      "@/env": [
        "./env.ts"
      ],
      "@/shared/*": [
        "../shared/*"
      ],
      "@/route-tree": [
        "../generated/route-tree.gen.ts"
      ],
      "@/route-manifest": [
        "../generated/route-manifest.gen.ts"
      ],
      "@/frontend/*": [
        "./*"
      ],
      "@/components/*": [
        "./components/*"
      ],
      "@/hooks/*": [
        "./hooks/*"
      ],
      "@/lib/*": [
        "./lib/*"
      ]
    }
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../shared/**/*.ts",
    "../shared/**/*.tsx",
    "../generated/route-tree.gen.ts",
    "../generated/route-manifest.gen.ts"
  ]
}
