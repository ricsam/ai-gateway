{
  "files": [],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/db": [
        "backend/db.ts"
      ],
      "@/env": [
        "backend/env.ts"
      ],
      "@/route-manifest": [
        "generated/route-manifest.gen.ts"
      ],
      "@/route-tree": [
        "generated/route-tree.gen.ts"
      ],
      "@/shared/*": [
        "shared/*"
      ],
      "@/frontend/*": [
        "frontend/*"
      ],
      "@/components/*": [
        "frontend/components/*"
      ],
      "@/hooks/*": [
        "frontend/hooks/*"
      ],
      "@/lib/*": [
        "frontend/lib/*"
      ]
    }
  },
  "references": [
    {
      "path": "./frontend"
    },
    {
      "path": "./backend"
    }
  ]
}
