{
  "name": "white-label-llm-proxy",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run routes:generate && bun --hot scripts/serve.ts",
    "start": "bun run routes:generate && NODE_ENV=production bun scripts/serve.ts --production",
    "serve": "bun scripts/serve.ts",
    "test": "bun test",
    "routes:generate": "bun scripts/generate-routes.ts",
    "typecheck": "bun run routes:generate && tsgo --noEmit --project frontend/tsconfig.json --composite false && tsgo --noEmit --project backend/tsconfig.json --composite false",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:reset": "bun scripts/reset-database.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1003.0",
    "@fontsource-variable/geist": "5.2.8",
