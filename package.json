    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@richie-router/core": "0.1.6",
    "@richie-router/react": "0.1.8",
    "@richie-router/server": "0.1.9",
    "@richie-router/tooling": "0.1.8",
    "@richie-rpc/client": "2.0.0",
    "@richie-rpc/core": "2.0.0",
    "@richie-rpc/react-query": "2.0.0",
    "@richie-rpc/server": "2.0.1",
    "@streamdown/code": "1.1.0",
    "@tabler/icons-react": "3.38.0",
    "@tanstack/react-query": "5.90.21",
    "better-auth": "1.5.3",
    "bun-plugin-tailwind": "0.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.44.7",
    "lucide-react": "0.574.0",
    "pg": "8.20.0",
    "radix-ui": "1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "3.8.5",
    "shiki": "3.21.0",
