{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Gateway Inference API",
    "version": "1.0.0",
    "description": "OpenAI-compatible and native AWS Bedrock inference endpoints with scoped API keys and credit settlement."
  },
  "servers": [
    {
      "url": "https://gateway.example.com",
      "description": "Replace with your deployment base URL"
    }
  ],
  "tags": [
    { "name": "OpenAI compatibility", "description": "OpenAI-compatible discovery and inference" },
    { "name": "Credits", "description": "Self-scoped user credit and usage information" },
    { "name": "Bedrock compatibility", "description": "Native Bedrock-shaped requests and responses" }
  ],
  "security": [{ "inferenceKey": [] }],
  "paths": {
    "/v1/chat/completions": {
      "post": {
        "tags": ["OpenAI compatibility"],
        "summary": "Create a chat completion",
        "description": "Translates an OpenAI Chat Completions request to AWS Bedrock Converse. Requires `ai.invoke`.",
        "operationId": "createChatCompletion",
        "parameters": [{ "$ref": "#/components/parameters/RequestId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChatCompletionRequest" },
              "example": {
                "model": "your-model-id",
                "messages": [{ "role": "user", "content": "Hello" }]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A completion or server-sent event stream",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ChatCompletionResponse" } },
              "text/event-stream": { "schema": { "type": "string" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "402": { "$ref": "#/components/responses/InsufficientCredits" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/v1/models": {
      "get": {
        "tags": ["OpenAI compatibility"],
        "summary": "List enabled models",
        "description": "Lists enabled Bedrock models. Requires `models.read`.",
        "operationId": "listModels",
        "responses": {
          "200": {
            "description": "Enabled model list",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ModelList" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/v1/credits": {
      "get": {
        "tags": ["Credits"],
        "summary": "Get credit balance",
        "description": "Returns the key owner's current balance and monthly allocation. Requires `credits.read`.",
        "operationId": "getCredits",
        "responses": {
          "200": {
            "description": "Current user credits",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreditBalance" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/v1/usage": {
      "get": {
        "tags": ["Credits"],
        "summary": "Get current-month usage",
        "description": "Returns the authenticated key owner's metered USD spend, current credits, allocation percentage, request count, and detailed token totals for the current UTC calendar month. The period end is exclusive, percentage is not capped, and it is null for a zero allocation. Requires `credits.read`.",
        "operationId": "getUsage",
        "responses": {
          "200": {
            "description": "Current UTC calendar-month usage",
            "headers": { "Cache-Control": { "schema": { "type": "string", "const": "no-store" } } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UsageSummary" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/user/daily/activity": {
      "get": {
        "tags": ["Credits"],
        "summary": "Get LiteLLM-compatible daily activity",
        "description": "Returns the authenticated key owner's daily spend, token, request, model, Bedrock provider, and opaque API-key breakdowns using the core LiteLLM `/user/daily/activity` response shape. This focused compatibility subset is non-paginated and accepts no target user. Dates are inclusive UTC dates and the maximum range is 366 days. Requires `credits.read`.",
        "operationId": "getUserDailyActivity",
        "parameters": [
          { "name": "start_date", "in": "query", "required": true, "schema": { "type": "string", "format": "date" } },
          { "name": "end_date", "in": "query", "required": true, "schema": { "type": "string", "format": "date" } }
        ],
        "responses": {
          "200": {
            "description": "Daily usage activity in descending date order",
            "headers": { "Cache-Control": { "schema": { "type": "string", "const": "no-store" } } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LiteLLMDailyActivity" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/gateway/bedrock/converse": {
      "post": {
        "tags": ["Bedrock compatibility"],
        "summary": "Call Bedrock Converse",
        "description": "Passes a Bedrock Converse-shaped request through the configured catalog and settlement boundary. Requires `ai.invoke`.",
        "operationId": "bedrockConverse",
        "parameters": [{ "$ref": "#/components/parameters/RequestId" }],
        "requestBody": { "$ref": "#/components/requestBodies/BedrockRequest" },
        "responses": {
          "200": { "description": "AWS Bedrock Converse response", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "402": { "$ref": "#/components/responses/InsufficientCredits" }
        }
      }
    },
    "/api/gateway/bedrock/converse-stream": {
      "post": {
        "tags": ["Bedrock compatibility"],
        "summary": "Stream Bedrock Converse",
        "description": "Returns Bedrock Converse stream events as newline-delimited JSON. Requires `ai.invoke`.",
        "operationId": "bedrockConverseStream",
        "parameters": [{ "$ref": "#/components/parameters/RequestId" }],
        "requestBody": { "$ref": "#/components/requestBodies/BedrockRequest" },
        "responses": {
          "200": { "description": "Newline-delimited Bedrock events", "content": { "application/x-ndjson": { "schema": { "type": "string" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "402": { "$ref": "#/components/responses/InsufficientCredits" }
        }
      }
    },
    "/api/gateway/bedrock/invoke": {
      "post": {
        "tags": ["Bedrock compatibility"],
        "summary": "Call Bedrock InvokeModel",
        "description": "Passes a native model body to Bedrock InvokeModel. Requires `ai.invoke`.",
        "operationId": "bedrockInvoke",
        "parameters": [{ "$ref": "#/components/parameters/RequestId" }],
        "requestBody": { "$ref": "#/components/requestBodies/BedrockInvokeRequest" },
        "responses": {
          "200": { "description": "Provider response body", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "402": { "$ref": "#/components/responses/InsufficientCredits" }
        }
      }
    },
    "/api/gateway/bedrock/invoke-stream": {
      "post": {
        "tags": ["Bedrock compatibility"],
        "summary": "Stream Bedrock InvokeModel",
        "description": "Passes native provider event bytes through as an octet stream. Requires `ai.invoke`.",
        "operationId": "bedrockInvokeStream",
        "parameters": [{ "$ref": "#/components/parameters/RequestId" }],
        "requestBody": { "$ref": "#/components/requestBodies/BedrockInvokeRequest" },
        "responses": {
          "200": { "description": "Provider binary event stream", "content": { "application/octet-stream": { "schema": { "type": "string", "format": "binary" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "402": { "$ref": "#/components/responses/InsufficientCredits" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "inferenceKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "aig_",
        "description": "An inference API key created in Profile, API & usage."
      }
    },
    "parameters": {
      "RequestId": {
        "name": "X-Request-ID",
        "in": "header",
        "required": false,
        "description": "Stable ID for exactly-once credit settlement across retries.",
        "schema": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" }
      }
    },
    "requestBodies": {
      "BedrockRequest": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["modelId", "messages"],
              "properties": {
                "modelId": { "type": "string" },
                "messages": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
              },
              "additionalProperties": true
            }
          }
        }
      },
      "BedrockInvokeRequest": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["modelId", "body"],
              "properties": {
                "modelId": { "type": "string" },
                "body": { "description": "Native request body for the selected model" }
              },
              "additionalProperties": true
            }
          }
        }
      }
    },
    "responses": {
      "BadRequest": { "description": "Invalid request or unavailable model", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Unauthorized": { "description": "Missing or invalid API key", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "InsufficientCredits": { "description": "The user has no available credits", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Forbidden": { "description": "Disabled access or insufficient scope", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Unavailable": { "description": "Bedrock is not configured or unavailable", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    },
    "schemas": {
      "Message": {
        "oneOf": [
          {
            "type": "object",
            "required": ["role", "content"],
            "properties": { "role": { "type": "string", "enum": ["system", "developer"] }, "content": { "type": "string" } }
          },
          {
            "type": "object",
            "required": ["role", "content"],
            "properties": { "role": { "const": "user" }, "content": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "object", "additionalProperties": true } }] } }
          },
          {
            "type": "object",
            "required": ["role"],
            "properties": { "role": { "const": "assistant" }, "content": { "type": ["string", "null"] }, "tool_calls": { "type": "array", "items": { "type": "object", "additionalProperties": true } } }
          },
          {
            "type": "object",
            "required": ["role", "content", "tool_call_id"],
            "properties": { "role": { "const": "tool" }, "content": { "type": "string" }, "tool_call_id": { "type": "string" } }
          }
        ]
      },
      "ChatCompletionRequest": {
        "type": "object",
        "required": ["model", "messages"],
        "properties": {
          "model": { "type": "string" },
          "messages": { "type": "array", "minItems": 1, "items": { "$ref": "#/components/schemas/Message" } },
          "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
          "top_p": { "type": "number", "minimum": 0, "maximum": 1 },
          "max_tokens": { "type": "integer", "minimum": 1 },
          "stop": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
          "stream": { "type": "boolean", "default": false },
          "reasoning_effort": { "type": "string", "enum": ["low", "medium", "high"] },
          "tools": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
          "tool_choice": { "description": "auto, required, none, or a named function", "oneOf": [{ "type": "string", "enum": ["auto", "required", "none"] }, { "type": "object", "additionalProperties": true }] },
          "n": { "const": 1 }
        }
      },
      "Usage": {
        "type": "object",
        "required": ["prompt_tokens", "completion_tokens", "total_tokens"],
        "properties": {
          "prompt_tokens": { "type": "integer" },
          "completion_tokens": { "type": "integer" },
          "total_tokens": { "type": "integer" }
        }
      },
      "ChatCompletionResponse": {
        "type": "object",
        "required": ["id", "object", "created", "model", "choices", "usage"],
        "properties": {
          "id": { "type": "string" },
          "object": { "const": "chat.completion" },
          "created": { "type": "integer" },
          "model": { "type": "string" },
          "choices": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
          "usage": { "$ref": "#/components/schemas/Usage" }
        }
      },
      "ModelList": {
        "type": "object",
        "required": ["object", "data"],
        "properties": {
          "object": { "const": "list" },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "object", "created", "owned_by"],
              "properties": {
                "id": { "type": "string" },
                "object": { "const": "model" },
                "created": { "type": "integer" },
                "owned_by": { "const": "ai-gateway" }
              }
            }
          }
        }
      },
      "CreditBalance": {
        "type": "object",
        "required": ["object", "currency", "balance", "monthly_allocation"],
        "properties": {
          "object": { "const": "credit_balance" },
          "currency": { "const": "USD" },
          "balance": { "type": "number" },
          "monthly_allocation": { "type": "number" }
        }
      },
      "UsageSummary": {
        "type": "object",
        "required": ["object", "currency", "period", "credits", "requests", "tokens"],
        "properties": {
          "object": { "const": "usage_summary" },
          "currency": { "const": "USD" },
          "period": {
            "type": "object",
            "required": ["start", "end", "timezone"],
            "properties": {
              "start": { "type": "string", "format": "date-time" },
              "end": { "type": "string", "format": "date-time", "description": "Exclusive period end" },
              "timezone": { "const": "UTC" }
            }
          },
          "credits": {
            "type": "object",
            "required": ["used", "balance", "monthly_allocation", "percent_used"],
            "properties": {
              "used": { "type": "number", "description": "Metered USD charged in this period" },
              "balance": { "type": "number", "description": "Current balance, not a historical period-end balance" },
              "monthly_allocation": { "type": "number" },
              "percent_used": { "type": ["number", "null"], "description": "Used divided by allocation times 100; null when allocation is zero" }
            }
          },
          "requests": { "type": "integer" },
          "tokens": {
            "type": "object",
            "required": ["input", "output", "cache_read", "cache_write_5m", "cache_write_1h", "cache_write", "total"],
            "properties": {
              "input": { "type": "integer" },
              "output": { "type": "integer" },
              "cache_read": { "type": "integer" },
              "cache_write_5m": { "type": "integer" },
              "cache_write_1h": { "type": "integer" },
              "cache_write": { "type": "integer" },
              "total": { "type": "integer", "description": "Input, output, cache-read, and cache-write tokens" }
            }
          }
        }
      },
      "LiteLLMMetrics": {
        "type": "object",
        "required": ["spend", "prompt_tokens", "completion_tokens", "total_tokens", "cache_read_input_tokens", "cache_creation_input_tokens", "api_requests"],
        "properties": {
          "spend": { "type": "number" },
          "prompt_tokens": { "type": "integer" },
          "completion_tokens": { "type": "integer" },
          "total_tokens": { "type": "integer", "description": "Prompt plus completion tokens, matching LiteLLM semantics" },
          "cache_read_input_tokens": { "type": "integer" },
          "cache_creation_input_tokens": { "type": "integer" },
          "api_requests": { "type": "integer" }
        }
      },
      "LiteLLMBreakdownEntry": {
        "type": "object",
        "required": ["metrics", "metadata"],
        "properties": {
          "metrics": { "$ref": "#/components/schemas/LiteLLMMetrics" },
          "metadata": { "type": "object", "additionalProperties": true }
        }
      },
      "LiteLLMDailyActivity": {
        "type": "object",
        "required": ["results", "metadata"],
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["date", "metrics", "breakdown"],
              "properties": {
                "date": { "type": "string", "format": "date" },
                "metrics": { "$ref": "#/components/schemas/LiteLLMMetrics" },
                "breakdown": {
                  "type": "object",
                  "required": ["models", "providers", "api_keys"],
                  "properties": {
                    "models": { "type": "object", "additionalProperties": { "$ref": "#/components/schemas/LiteLLMBreakdownEntry" } },
                    "providers": { "type": "object", "additionalProperties": { "$ref": "#/components/schemas/LiteLLMBreakdownEntry" } },
                    "api_keys": { "type": "object", "additionalProperties": { "$ref": "#/components/schemas/LiteLLMBreakdownEntry" } }
                  }
                }
              }
            }
          },
          "metadata": {
            "type": "object",
            "required": ["total_spend", "total_prompt_tokens", "total_completion_tokens", "total_tokens", "total_api_requests", "total_cache_read_input_tokens", "total_cache_creation_input_tokens", "page", "total_pages", "has_more"],
            "properties": {
              "total_spend": { "type": "number" },
              "total_prompt_tokens": { "type": "integer" },
              "total_completion_tokens": { "type": "integer" },
              "total_tokens": { "type": "integer" },
              "total_api_requests": { "type": "integer" },
              "total_cache_read_input_tokens": { "type": "integer" },
              "total_cache_creation_input_tokens": { "type": "integer" },
              "page": { "const": 1 },
              "total_pages": { "const": 1 },
              "has_more": { "const": false }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["message", "code"],
            "properties": {
              "message": { "type": "string" },
              "type": { "type": "string" },
              "code": { "type": ["string", "null"] },
              "param": { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  }
}
